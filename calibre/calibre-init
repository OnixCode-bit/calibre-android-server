#!/bin/sh
### BEGIN INIT INFO
# Provides:          calibre-server
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Servidor de conteúdo do Calibre
### END INIT INFO

# Script de boot: roda o calibre-server.sh como um usuário comum (nunca como root).
# Troque "usuario" pelo seu usuário do Debian.
RUN_AS="usuario"

case "$1" in
start | stop | restart | status)
    su - "$RUN_AS" -c "\$HOME/calibre/calibre-server.sh $1"
    ;;
*)
    echo "Uso: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
